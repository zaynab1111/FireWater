{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++.exe build active file",
      "command": "C:\\mingw64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "main.cpp",
        "GameEngine.cpp",
        "Entity.cpp",
        "GameObject.cpp",
        "Character.cpp",
        "Fireboy.cpp",
        "Watergirl.cpp",
        "Platform.cpp",
        "-o",
        "main.exe",
        "-IC:\\SFML-3.1.0\\include",
        "-LC:\\SFML-3.1.0\\lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-lsfml-audio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}